# 复制为 .env 后按本机实际值填写；不要把真实口令提交到版本库。
# 数据库连接串（示例中的口令请替换为本机生成值）
DATABASE_URL="postgresql://zsadmin:REPLACE_WITH_LOCAL_PASSWORD@127.0.0.1:5432/zhuan_demo?schema=public"

# 服务端口（仅本机监听）
PORT=3000
HOST=127.0.0.1

# 运行环境：development / demo。demo 会在界面顶部显示演示环境标识。
APP_ENV=demo
NODE_ENV=development

# 会话有效期（小时）
SESSION_TTL_HOURS=8

# 生产环境（HTTPS）置为 true；本地 http 调试必须为 false
COOKIE_SECURE=false

# 演示环境标识文案
DEMO_BANNER_TEXT=演示环境 · 数据仅供演示与功能验证，不代表真实经营成果
